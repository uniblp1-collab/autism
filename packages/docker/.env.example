# Копируется в корень репозитория как .env скриптом dev-up.sh (или вручную:
# cp packages/docker/.env.example .env). Используется контейнерами backend и frontend
# через env_file в docker-compose.yml.
#
# Важно: имена хостов ниже (postgres, minio) — это имена сервисов в docker-compose.yml,
# а не localhost, т.к. backend обращается к ним из другого контейнера той же docker-сети.
# Учётные данные postgres/minio захардкожены в docker-compose.yml (не читаются из .env
# самими сервисами postgres/minio) — значения ниже должны совпадать с ними.

PORT=3000
# TODO(открытый вопрос к заказчику, TASK_PATCH_1.md §5): часовой пояс контейнера backend —
# от него зависит, когда именно cron сбрасывает расписание в "00:00" (см. apps/backend/.env.example).
TZ=UTC
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/autism_connect?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS: адрес фронтенда как его видит браузер (не имя контейнера).
FRONTEND_URL=http://localhost:3000

S3_ENDPOINT=http://minio:9000
# В отличие от S3_ENDPOINT (внутренний хост "minio" для бэкенда) — адрес,
# по которому браузер загружает картинки карточек, должен быть внешним.
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=autism-connect-cards

# Создание первого админ-аккаунта через seed (Part B.5) — не хардкодить учётные данные в коде.
ADMIN_EMAIL=admin@autismconnect.local
ADMIN_PASSWORD=wTCfm8Afp5OXC8A7

# Адрес backend API как его видит браузер. Next.js встраивает NEXT_PUBLIC_* в бандл на
# этапе сборки (см. args в docker-compose.yml и apps/frontend/Dockerfile) — значение здесь
# используется дополнительно как runtime-переменная контейнера и для справки.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# TODO(безопасность, MVP-упрощение, ТЗ §A.7): без PIN-кода — см. apps/frontend/.env.example.
NEXT_PUBLIC_EDIT_MODE_ENABLED=true
