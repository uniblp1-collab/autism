// Prisma schema — единственный источник истины для структуры БД.
// Любое изменение сопровождается миграцией: `pnpm prisma:migrate --name <описание>`.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARENT
  SPECIALIST
  ADMIN
}

enum SpeechLevel {
  NONE
  SINGLE_WORDS
  PHRASES
  SENTENCES
}

enum CardSource {
  LIBRARY
  CUSTOM
  AI_GENERATED
}

enum CardType {
  NOUN
  ADJECTIVE
}

enum Gender {
  MASCULINE
  FEMININE
  NEUTER
}

// Общий размер карточек в сетке категории на экране ребёнка — переключается в режиме
// редактирования (карандаш), применяется ко всей сетке сразу, не к отдельным карточкам.
enum CardSize {
  SMALL
  MEDIUM
  LARGE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(PARENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  children Child[]

  @@map("users")
}

model Child {
  id                  String      @id @default(uuid())
  userId              String
  name                String
  age                 Int
  photoUrl            String?
  speechLevel         SpeechLevel @default(NONE)
  // Часть A.4/A.7 (редакция 3 механики): 1 — мгновенное озвучивание, 2 — видимая строка
  // сборки, 3 — то же + шаг выбора прилагательного с согласованием по роду.
  difficultyLevel     Int         @default(1)
  // Категории-глаголы, доступные ребёнку; "Дай" всегда подразумевается доступной
  // (проверяется в коде, не через отсутствие в этом списке — см. A.7).
  unlockedCategoryIds String[]    @default([])
  // Размер карточек в сетке — переключается в режиме редактирования экрана ребёнка.
  cardSize            CardSize    @default(SMALL)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  favoriteCategories ChildFavoriteCategory[]
  customCards        Card[]
  favorites          Favorite[]
  history            History[]
  schedules          Schedule[]
  statistics         Statistics[]

  @@index([userId])
  @@map("children")
}

// Редакция 3 механики: категория теперь сам глагол ("Дай", "Болит", "Идти", "Есть",
// "Мыться"), а не предметный домен ("Еда", "Напитки") — см. TASK_REVISE_MECHANICS_AND_ADMIN.md §A.1.
model Category {
  id       String  @id @default(uuid())
  title    String
  icon     String
  color    String  @default("#5F5E5A")
  order    Int     @default(0)
  isSystem Boolean @default(false)
  // true только у "Дай" — акцентная заливка в строке категорий (DESIGN.md).
  isPrimary Boolean @default(false)
  // Служебная категория-контейнер (для карточек Да/Нет и прилагательных) — не
  // рендерится пилюлей в строке категорий. Расширение сверх снимка схемы из
  // TASK_REVISE_MECHANICS_AND_ADMIN.md §A.1, понадобилось для непротиворечивого
  // хранения Да/Нет/прилагательных без "магических" эвристик на фронте.
  isHiddenFromNav Boolean @default(false)
  // Словоформа 1-го лица для вставки в предложение: "Есть" -> "Ем".
  phraseForm String @default("")
  // Шаблон сборки фразы: {verb}/{noun}/{adjective}. Дефолт "{verb} {noun}" — безопасный,
  // но не всегда естественный вариант; финальные шаблоны по категориям — открытый вопрос
  // к заказчику (см. отчёт по задаче), не решать самостоятельно.
  sentenceTemplate String    @default("{verb} {noun}")
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  cards           Card[]
  favoriteOfChild ChildFavoriteCategory[]

  @@map("categories")
}

model ChildFavoriteCategory {
  childId    String
  categoryId String

  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([childId, categoryId])
  @@map("child_favorite_categories")
}

model Card {
  id         String     @id @default(uuid())
  categoryId String
  childId    String?
  // Именительный падеж — для админки/библиотеки.
  title    String
  // Изображение теперь необязательно на момент создания — загружается отдельно
  // через POST /admin/cards/:id/image (см. StorageModule).
  imageUrl String?
  color    String  @default("#4F46E5")
  priority Int     @default(0)
  ttsText  String
  // Словоформа для вставки во фразу (винительный и т.д.): "каша" -> "кашу".
  phraseForm String   @default("")
  cardType   CardType @default(NOUN)
  // Только для NOUN (собственный род существительного) и ADJECTIVE (см. поля ниже) —
  // нужно для согласования на уровне сложности 3.
  gender Gender?
  // Явные словоформы прилагательного по родам — используются только при cardType: ADJECTIVE.
  // Осознанно не автогенерация по правилам (проще и надёжнее для старта, см. TASK §A.4).
  phraseFormMasculine String?
  phraseFormFeminine  String?
  phraseFormNeuter    String?
  source              CardSource @default(LIBRARY)
  isCustom            Boolean    @default(false)
  // true только для "Да"/"Нет" — рендерятся отдельной sticky-панелью, не в сетке категорий.
  isSystemCard Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  category         Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  child            Child?             @relation(fields: [childId], references: [id], onDelete: Cascade)
  favorites        Favorite[]
  historyItems     HistoryItem[]
  scheduleItems    ScheduleItem[]
  statisticEntries StatisticEntry[]

  @@index([categoryId])
  @@index([childId])
  @@index([title])
  @@map("cards")
}

model Favorite {
  id        String   @id @default(uuid())
  childId   String
  cardId    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([childId, cardId])
  @@map("favorites")
}

model History {
  id           String   @id @default(uuid())
  childId      String
  sentenceText String
  createdAt    DateTime @default(now())

  child Child         @relation(fields: [childId], references: [id], onDelete: Cascade)
  items HistoryItem[]

  @@index([childId, createdAt])
  @@map("history")
}

model HistoryItem {
  id        String @id @default(uuid())
  historyId String
  cardId    String
  position  Int

  history History @relation(fields: [historyId], references: [id], onDelete: Cascade)
  card    Card    @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@index([historyId])
  @@map("history_items")
}

model Schedule {
  id        String   @id @default(uuid())
  childId   String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  child Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  items ScheduleItem[]

  @@index([childId])
  @@map("schedules")
}

model ScheduleItem {
  id          String    @id @default(uuid())
  scheduleId  String
  cardId      String?
  title       String
  order       Int       @default(0)
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  card     Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)

  @@index([scheduleId, order])
  @@map("schedule_items")
}

model Statistics {
  id                  String   @id @default(uuid())
  childId             String
  day                 DateTime @db.Date
  totalCommunications Int      @default(0)
  createdAt           DateTime @default(now())

  child   Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  entries StatisticEntry[]

  @@unique([childId, day])
  @@map("statistics")
}

model StatisticEntry {
  id           String @id @default(uuid())
  statisticsId String
  cardId       String
  usageCount   Int    @default(0)

  statistics Statistics @relation(fields: [statisticsId], references: [id], onDelete: Cascade)
  card       Card       @relation(fields: [cardId], references: [id], onDelete: Restrict)

  @@unique([statisticsId, cardId])
  @@map("statistic_entries")
}
