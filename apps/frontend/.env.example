# Адрес backend, на который сервер Next.js проксирует запросы /api/... (см. next.config.js
# rewrites). Локально без Docker backend слушает localhost:4000. Читается сервером Next.js
# в рантайме (в т.ч. `next dev`), не встраивается в браузерный бандл как NEXT_PUBLIC_*.
BACKEND_INTERNAL_URL=http://localhost:4000

# NEXT_PUBLIC_API_URL больше не нужен: браузер ходит на относительный /api/... того же origin
# (см. shared/api/client.ts). Прокси на backend делает Next.js через rewrites.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api

# TODO(безопасность, MVP-упрощение, ТЗ §A.7): режим редактирования на экране ребёнка пока
# не защищён PIN-кодом — этот флаг лишь глобально включает/выключает саму возможность
# редактирования. По умолчанию включён для dev/test; для продакшена ожидается PIN-гейт
# поверх этого флага (не реализован в этой итерации по явному указанию техзадания).
NEXT_PUBLIC_EDIT_MODE_ENABLED=true
