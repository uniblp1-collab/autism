# Пример переменных окружения для локальной разработки без Docker.
# Каждое приложение также имеет собственный .env.example:
#   apps/backend/.env.example
#   apps/frontend/.env.example
#   packages/database/.env  (DATABASE_URL для Prisma CLI)
#   packages/docker/.env.example (переменные для docker-compose)
#
# Скопируйте нужные файлы в .env / .env.local перед запуском.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/autism_connect?schema=public"

# TODO(открытый вопрос к заказчику, TASK_PATCH_1.md §5): часовой пояс для ежедневного
# cron-сброса расписания (00:00 по времени процесса, не UTC по умолчанию) — см. apps/backend/.env.example.
TZ=UTC

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:3000

# Локальный запуск без Docker — путь относительно cwd процесса backend (apps/backend/),
# а не абсолютный /app/... из Docker-образа (см. apps/backend/.env.example и
# packages/docker/.env.example).
UPLOAD_DIR=./uploads/cards
# PUBLIC_BASE_URL больше не используется: картинки карточек отдаются относительным путём
# /uploads/... того же origin, что и сайт (Next.js проксирует /uploads на backend, см.
# next.config.js). Абсолютный адрес backend в URL картинки ломал показ снаружи (мобильный/туннель).
# PUBLIC_BASE_URL=http://localhost:4000

# Создание первого админ-аккаунта через seed (Part B.5) — не хардкодить учётные данные в коде.
# Пароль ниже — сгенерированный тестовый пароль для этого окружения (см. отчёт по патчу),
# не финальный продакшен-секрет — при реальном деплое сгенерировать новый.
ADMIN_EMAIL=admin@autismconnect.local
ADMIN_PASSWORD=wTCfm8Afp5OXC8A7

# Адрес backend, на который сервер Next.js проксирует запросы /api/... (см. next.config.js
# rewrites). Для локального запуска без Docker backend слушает localhost:4000 (переменная PORT
# по умолчанию). В docker-compose значение другое (http://backend:3000) — см.
# packages/docker/.env.example.
BACKEND_INTERNAL_URL=http://localhost:4000

# NEXT_PUBLIC_API_URL больше не используется: браузер обращается к API относительным путём
# /api/... того же origin (см. shared/api/client.ts). Оставлено закомментированным для истории.
# NEXT_PUBLIC_API_URL=http://localhost:4000/api

# TODO(безопасность, MVP-упрощение, ТЗ §A.7): режим редактирования экрана ребёнка пока без
# PIN-кода — см. apps/frontend/.env.example для пояснения.
NEXT_PUBLIC_EDIT_MODE_ENABLED=true
