{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@autism-connect/shared": ["packages/shared/src/index.ts"],
      "@autism-connect/shared/*": ["packages/shared/src/*"],
      "@autism-connect/ui": ["packages/ui/src/index.ts"],
      "@autism-connect/ui/*": ["packages/ui/src/*"]
    }
  }
}
